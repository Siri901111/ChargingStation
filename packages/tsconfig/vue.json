{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "display": "Vue Application",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
