{
  "extends": "@charging/tsconfig/library.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "declarationDir": "./dist",
    "outDir": "./dist",
    "rootDir": "./src",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*", "src/globals.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
