/**
 * 臻品设计系统 - 主入口
 *
 * 融合东方美学与现代极简
 * 打造高端、雅致、有品位的用户体验
 */
/**
 * 臻品设计系统 v3.0
 *
 * 设计哲学：
 * - 喜茶：极致留白、无边界、呼吸感、年轻高级
 * - 故宫：东方意境、克制用色、历史沉淀、文化底蕴
 * - Apple：精致细节、微妙层次、触感反馈
 *
 * 核心理念：少即是多 | 留白即奢侈 | 细节见品质
 */
:root {
  --ink-100: #0A0A0A;
  --ink-90: #1A1A1A;
  --ink-80: #2D2D2D;
  --ink-70: #404040;
  --ink-60: #595959;
  --ink-50: #737373;
  --ink-40: #8C8C8C;
  --ink-30: #A6A6A6;
  --ink-20: #BFBFBF;
  --ink-15: #D9D9D9;
  --ink-10: #E8E8E8;
  --ink-05: #F2F2F2;
  --ink-02: #FAFAFA;
  --paper: #FFFFFF;
  --paper-warm: #FDFCFB;
  --paper-cream: #FAF9F7;
  --paper-ivory: #F8F7F4;
  --gold: #B8996F;
  --gold-light: #D4C4A8;
  --gold-dark: #9A7B4F;
  --jade: #5A8F7B;
  --jade-light: #7DB4A0;
  --jade-dark: #3D6B5A;
  --vermilion: #C4554A;
  --vermilion-light: #E8857A;
  --amber: #D4A84B;
  --cyan: #5B8C94;
  --success: var(--jade);
  --warning: var(--amber);
  --error: var(--vermilion);
  --info: var(--cyan);
  --text-primary: var(--ink-90);
  --text-regular: var(--ink-70);
  --text-secondary: var(--ink-50);
  --text-placeholder: var(--ink-40);
  --text-disabled: var(--ink-30);
  --text-inverse: var(--paper);
  --bg-page: var(--paper-cream);
  --bg-card: var(--paper);
  --bg-elevated: var(--paper-warm);
  --bg-mask: rgba(0, 0, 0, 0.4);
  --border: var(--ink-10);
  --border-light: var(--ink-05);
  --divider: var(--ink-10);
  --shadow-xs: 0 1rpx 4rpx rgba(0, 0, 0, 0.02);
  --shadow-sm: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  --shadow-md: 0 8rpx 32rpx rgba(0, 0, 0, 0.05);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.06);
  --shadow-xl: 0 24rpx 64rpx rgba(0, 0, 0, 0.08);
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-2xl: 40rpx;
  --radius-full: 1000rpx;
  --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
  --font-serif: "Noto Serif SC", "Source Han Serif SC", "Songti SC", serif;
  --font-mono: "SF Mono", "JetBrains Mono", "PingFang SC", monospace;
  --text-xs: 22rpx;
  --text-sm: 26rpx;
  --text-base: 30rpx;
  --text-lg: 34rpx;
  --text-xl: 40rpx;
  --text-2xl: 48rpx;
  --text-3xl: 60rpx;
  --text-4xl: 80rpx;
  --text-5xl: 100rpx;
  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;
  --leading-tight: 1.25;
  --leading-snug: 1.4;
  --leading-normal: 1.6;
  --leading-relaxed: 1.8;
  --tracking-tight: -0.02em;
  --tracking-normal: 0;
  --tracking-wide: 0.02em;
  --tracking-wider: 0.05em;
  --tracking-widest: 0.1em;
  --space-0: 0;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;
  --space-10: 80rpx;
  --space-12: 96rpx;
  --space-16: 128rpx;
  --space-20: 160rpx;
  --space-24: 192rpx;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
  --duration-fast: 150ms;
  --duration-normal: 250ms;
  --duration-slow: 400ms;
}
page {
  background-color: var(--bg-page);
  font-family: var(--font-sans);
  font-size: var(--text-base);
  color: var(--text-primary);
  line-height: var(--leading-normal);
  letter-spacing: var(--tracking-wide);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
view, text, image {
  box-sizing: border-box;
}
.safe-top {
