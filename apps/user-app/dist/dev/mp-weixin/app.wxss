.card {
  background-color: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-5);
  margin: 0 var(--space-4) var(--space-4);
}
.card-elevated {
  background-color: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-5);
  margin: 0 var(--space-4) var(--space-4);
  box-shadow: var(--shadow-md);
}
.card-outlined {
  background-color: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-5);
  margin: 0 var(--space-4) var(--space-4);
  border: 1rpx solid var(--border);
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  padding: 0 var(--space-8);
  font-size: var(--text-base);
  font-weight: var(--weight-medium);
  letter-spacing: var(--tracking-wider);
  border-radius: var(--radius-full);
  border: none;
  outline: none;
  position: relative;
  overflow: hidden;
  transition: all var(--duration-normal) var(--ease-out);
}
.btn::after {
  display: none;
}
.btn:active {
  transform: scale(0.97);
}
.btn-primary {
  background: var(--ink-90);
  color: var(--text-inverse);
}
.btn-primary:active {
  background: var(--ink-100);
}
.btn-jade {
  background: var(--jade);
  color: var(--text-inverse);
}
.btn-jade:active {
  background: var(--jade-dark);
}
.btn-gold {
  background: var(--gold);
  color: var(--text-inverse);
}
.btn-gold:active {
  background: var(--gold-dark);
}
.btn-secondary {
  background: transparent;
  color: var(--text-primary);
  border: 1rpx solid var(--ink-20);
}
.btn-secondary:active {
  background: var(--ink-05);
  border-color: var(--ink-40);
}
.btn-ghost {
  background: transparent;
  color: var(--text-regular);
  padding: 0 var(--space-4);
}
.btn-ghost:active {
  color: var(--text-primary);
}
.btn-sm {
  height: 76rpx;
  padding: 0 var(--space-5);
  font-size: var(--text-sm);
}
.btn-lg {
  height: 112rpx;
  font-size: var(--text-lg);
}
.btn-block {
  width: 100%;
}
.btn:disabled,
.btn-disabled {
  opacity: 0.4;
  pointer-events: none;
}
.input-wrap {
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 var(--space-4);
  background: var(--ink-02);
  border-radius: var(--radius-lg);
  border: 2rpx solid transparent;
  transition: all var(--duration-fast) var(--ease-out);
}
.input-wrap:focus-within {
  background: var(--bg-card);
  border-color: var(--ink-20);
}
.input-wrap input {
  flex: 1;
  height: 100%;
  font-size: var(--text-base);
  color: var(--text-primary);
  background: transparent;
}
.input-wrap input::-moz-placeholder {
  color: var(--text-placeholder);
}
.input-wrap input::placeholder {
  color: var(--text-placeholder);
}
.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 var(--space-3);
  font-size: var(--text-xs);
  font-weight: var(--weight-medium);
  letter-spacing: var(--tracking-wide);
  border-radius: var(--radius-sm);
}
.tag-jade {
  color: var(--jade);
  background: rgba(90, 143, 123, 0.1);
}
.tag-gold {
  color: var(--gold);
  background: rgba(184, 153, 111, 0.1);
}
.tag-grey {
  color: var(--text-secondary);
  background: var(--ink-05);
}
.tag-dark {
  color: var(--text-inverse);
  background: var(--ink-80);
}
.divider {
  height: 1rpx;
  background: var(--divider);
  margin: var(--space-4) 0;
}
.divider-section {
  height: 16rpx;
  background: var(--bg-page);
  margin: 0 calc(-1 * var(--space-4));
}
.list-item {
  display: flex;
  align-items: center;
  padding: var(--space-4) 0;
  border-bottom: 1rpx solid var(--border-light);
  transition: opacity var(--duration-fast);
}
.list-item:last-child {
  border-bottom: none;
}
.list-item:active {
  opacity: 0.7;
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-16) var(--space-5);
  text-align: center;
}
.empty-icon {
  font-size: 160rpx;
  color: var(--ink-15);
  margin-bottom: var(--space-5);
}
.empty-title {
  font-size: var(--text-lg);
  color: var(--text-regular);
  margin-bottom: var(--space-2);
}
.empty-desc {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-6);
  color: var(--text-secondary);
  font-size: var(--text-sm);
}
.loading::before {
  content: "";
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--border);
  border-top-color: var(--jade);
  border-radius: 50%;
  margin-right: var(--space-2);
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
to {
    transform: rotate(360deg);
}
}
.fade-in {
  animation: fadeIn var(--duration-normal) var(--ease-out);
}
@keyframes fadeIn {
from {
    opacity: 0;
}
to {
    opacity: 1;
}
}
.slide-up {
  animation: slideUp var(--duration-normal) var(--ease-out) both;
}
@keyframes slideUp {
from {
    opacity: 0;
    transform: translateY(24rpx);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
.scale-in {
  animation: scaleIn var(--duration-normal) var(--ease-spring) both;
}
@keyframes scaleIn {
from {
    opacity: 0;
    transform: scale(0.9);
}
to {
    opacity: 1;
    transform: scale(1);
}
}
.touchable {
  transition: all var(--duration-fast) var(--ease-out);
}
.touchable:active {
  transform: scale(0.98);
  opacity: 0.8;
}
.hover-lift {
  transition: all var(--duration-normal) var(--ease-out);
}
.hover-lift:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-lg);
}
