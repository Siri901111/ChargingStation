.page.data-v-a4b7abaf {
  min-height: 100vh;
  background-color: var(--bg-color);
}
.tabs.data-v-a4b7abaf {
  display: flex;
  background-color: #FFFFFF;
  padding: 0 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item.data-v-a4b7abaf {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}
.tab-item.active.data-v-a4b7abaf {
  color: var(--primary-color);
  font-weight: bold;
}
.tab-item.active.data-v-a4b7abaf::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background-color: var(--primary-color);
  border-radius: 3rpx;
}
.order-list.data-v-a4b7abaf {
  height: calc(100vh - 88rpx);
  padding: 24rpx;
}
.order-card.data-v-a4b7abaf {
  margin-bottom: 24rpx;
}
.order-header.data-v-a4b7abaf {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.order-station.data-v-a4b7abaf {
  font-size: 30rpx;
  font-weight: bold;
}
.order-status.data-v-a4b7abaf {
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
