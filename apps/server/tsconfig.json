{
  "extends": "@charging/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
